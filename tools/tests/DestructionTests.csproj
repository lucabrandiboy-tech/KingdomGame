<!--
  Unit tests for the game code that doesn't need Unity: the destruction math
  (Assets/Scripts/Destruction/DamageShape.cs and PixelAlgorithms.cs) and the
  villagers' path search (Assets/Scripts/Villagers/GridPathfinder.cs).
  The Repo checks GitHub Action runs them on every push. To run them
  yourself, see "Checks to run before every commit" in CLAUDE.md.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BaseOutputPath>$(MSBuildThisFileDirectory)bin/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../Assets/Scripts/Destruction/DamageShape.cs" />
    <Compile Include="../../Assets/Scripts/Destruction/PixelAlgorithms.cs" />
    <Compile Include="../../Assets/Scripts/Villagers/GridPathfinder.cs" />
  </ItemGroup>
</Project>
